# Clerk publishable key (https://dashboard.clerk.com → API keys). Sign-in is hidden when unset.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, the name Vercel's Clerk integration uses, also works.
VITE_CLERK_PUBLISHABLE_KEY=

# Upstash Redis REST credentials for saving drawings to accounts (api/doc.ts).
# Vercel's Upstash integration sets these on the project; `vercel env pull` copies them here.
KV_REST_API_URL=
KV_REST_API_TOKEN=
